  "depth_weight": 1,
  "pose_weight": 1,
  "local_heatmap_weight": 0,
  "train_eval_interval": 500,
  "body_depth_balance": 0.5,
  "keypoint_3d_weight": 0,
  "reprojection_weight": 0,
  "primary_metrics": [
    "box_matched_nme",
    "detection_aware_pck_0.1",
    "body_depth_absrel"
