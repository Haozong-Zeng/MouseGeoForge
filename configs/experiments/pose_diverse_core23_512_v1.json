{
  "schema_version": 1,
  "purpose": "expanded_multidataset_core23_512_v1",
  "seeds": [
    17
  ],
  "modes": [
    "off"
  ],
  "steps": 15000,
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "gradient_clip": 1,
  "train_frames_per_source": 32,
