  "checkpoint_policy": "fixed_final_step_no_validation_selection",
  "split_policy": "climb_train_wash_val_and_CRIM13_source_session_disjoint",
  "notes": "400 unique train scenes (200 dual, 200 single) across four complete-Core23 Blender datasets; same 32 held-out scenes. Same seed17 fresh initialization, 15000-step hold/cosine LR, heads, losses and two cameras. No augmentation, ROI, temporal, partial-label or real-image mix. More data and broader appearance/motion coverage jointly change; same updates not equal epochs. Both Sample10 segments grouped train, no wash/walk or held-out CRIM13 leakage.",
  "lr_schedule": {
    "type": "hold_cosine",
    "hold_steps": 5000,
    "min_learning_rate": 0.00001
