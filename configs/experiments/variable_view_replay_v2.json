{
  "schema_version": 2,
  "seed": 17,
  "steps": 800,
  "arms": ["shuffled_variable", "mixed_replay"],
  "train_scenes": 32,
  "development_scenes": 8,
  "single_train_per_source": 16,
  "learning_rate": 0.00003,
  "weight_decay": 0.01,
  "gradient_clip": 1.0,
  "long_side": 768,
  "encoder_frozen": true,
  "coupling": "off",
  "geometry_loss_weights": 0,
  "uncertainty_loss_weight": 0,
  "local_heatmap_weight": 0,
  "depth_weight": 1,
  "pose_weight": 1,
  "cache_limit_gib": 32,
  "max_run_hours": 2,
  "checkpoint": "output/pose_diverse_core23_768_v1/seed17_off/final_heads.pt",
  "manifest": "output/pose_diverse_core23_768_v1/manifest.json",
  "checkpoint_policy": "fixed final step; no development checkpoint selection",
  "replay_policy": "50% shared variable dual, 25% original dual pair, 25% original single pair",
  "budget_policy": "800 updates each; control has twice the variable exposure; report actual images and shape-dependent patch tokens",
  "acceptance": {
    "new_view_nme_ratio_max": 0.9,
    "retention_nme_ratio_max": 1.05,
    "retention_detection_aware_pck_drop_max": 0.03,
    "body_depth_absrel_ratio_max": 1.10,
    "reference": "original checkpoint, not weakened fine-tuned control",
    "no_automatic_production_promotion": true
  }
}
